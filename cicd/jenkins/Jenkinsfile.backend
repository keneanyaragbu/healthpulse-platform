pipeline {
    agent any

    environment {
        APP_NAME = 'healthpulse-backend'
        IMAGE_NAME = 'keneanyaragbu/healthpulse-backend'
        IMAGE_TAG = "${BUILD_NUMBER}"
        BACKEND_DIR = 'app/backend'

        ARTIFACTORY_REGISTRY = '34.204.100.27:8082'
        ARTIFACTORY_REPO = 'docker-local'
        ARTIFACTORY_IMAGE = "${ARTIFACTORY_REGISTRY}/${ARTIFACTORY_REPO}/${APP_NAME}:${IMAGE_TAG}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Backend Files') {
            steps {
                sh '''
                    echo "Checking backend project files..."
                    ls -la ${BACKEND_DIR}
                    test -f ${BACKEND_DIR}/Dockerfile
                    test -f ${BACKEND_DIR}/package.json
                    test -f ${BACKEND_DIR}/package-lock.json
                    test -f ${BACKEND_DIR}/server.js
                    test -f ${BACKEND_DIR}/sonar-project.properties
                '''
            }
        }

        stage('Install Backend Dependencies') {
            steps {
                sh '''
                    cd ${BACKEND_DIR}
                    npm install
                '''
            }
        }

        stage('Run Backend Tests') {
            steps {
                sh '''
                    cd ${BACKEND_DIR}
                    npm test
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    dir("${BACKEND_DIR}") {
                        withSonarQubeEnv('SonarQube') {
                            sh """
                                ${scannerHome}/bin/sonar-scanner
                            """
                        }
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Snyk Dependency Scan') {
            steps {
                dir("${BACKEND_DIR}") {
                    snykSecurity(
                        snykInstallation: 'snyk',
                        snykTokenId: 'healthpulse-snyk-token',
                        severity: 'high',
                        failOnIssues: true,
                        failOnError: true,
                        monitorProjectOnBuild: true,
                        targetFile: 'package.json'
                    )
                }
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                sh '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ${BACKEND_DIR}
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${ARTIFACTORY_IMAGE}
                '''
            }
        }

        stage('Snyk Container Scan') {
            steps {
                script {
                    def snykHome = tool 'snyk'

                    withCredentials([string(credentialsId: 'healthpulse-snyk-cli-token', variable: 'SNYK_TOKEN')]) {
                        sh """
                            ${snykHome}/snyk auth ${SNYK_TOKEN}
                            ${snykHome}/snyk container test ${IMAGE_NAME}:${IMAGE_TAG} --severity-threshold=high
                            ${snykHome}/snyk container monitor ${IMAGE_NAME}:${IMAGE_TAG}
                        """
                    }
                }
            }
        }

        stage('Trivy Container Scan') {
            steps {
                sh '''
                    trivy image --severity HIGH,CRITICAL --exit-code 1 ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Smoke Test Docker Image') {
            steps {
                sh '''
                    docker rm -f ${APP_NAME}-smoke-test || true
                    docker run -d --name ${APP_NAME}-smoke-test -p 3001:3000 ${IMAGE_NAME}:${IMAGE_TAG}
                    sleep 5
                    curl -f http://localhost:3001/api/health
                    docker rm -f ${APP_NAME}-smoke-test || true
                '''
            }
        }

        stage('Push Image to Artifactory') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'artifactory-creds', usernameVariable: 'ARTIFACTORY_USER', passwordVariable: 'ARTIFACTORY_PASSWORD')]) { // pragma: allowlist secret
                    sh '''
                        echo "${ARTIFACTORY_PASSWORD}" | docker login ${ARTIFACTORY_REGISTRY} -u "${ARTIFACTORY_USER}" --password-stdin
                        docker push ${ARTIFACTORY_IMAGE}
                        docker logout ${ARTIFACTORY_REGISTRY}
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker rm -f ${APP_NAME}-smoke-test || true
            '''
        }
    }
}
